{% extends 'base.html.twig' %}

{% block title %}Résultats — Symfony Certification Quiz{% endblock %}

{% block body %}
<div class="text-center mb-8">
    <h1 class="text-3xl font-bold text-gray-800 mb-2">Résultats du quiz</h1>
</div>

{# Score principal #}
<div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8 mb-6 text-center">
    <div class="text-7xl font-bold mb-2
        {% if score >= 75 %}text-green-500
        {% elseif score >= 50 %}text-yellow-500
        {% else %}text-red-500
        {% endif %}">
        {{ score }}%
    </div>
    <p class="text-gray-500 text-lg">
        {{ correct_count }} bonne{{ correct_count > 1 ? 's' : '' }} réponse{{ correct_count > 1 ? 's' : '' }}
        sur {{ total }} questions
    </p>
    {% if score >= 75 %}
        <p class="mt-3 text-green-600 font-medium">🎉 Score de réussite atteint !</p>
    {% elseif score >= 50 %}
        <p class="mt-3 text-yellow-600 font-medium">📈 Encore quelques efforts !</p>
    {% else %}
        <p class="mt-3 text-red-600 font-medium">💪 Continue à t'entraîner !</p>
    {% endif %}
</div>

{# Répartition par thème #}
<div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 mb-6">
    <h2 class="text-lg font-semibold text-gray-700 mb-4">Résultats par thème</h2>
    <div class="space-y-3">
        {% for theme, stats in stats_by_theme %}
            {% set pct = stats.total > 0 ? (stats.correct / stats.total * 100)|round : 0 %}
            <div>
                <div class="flex justify-between text-sm mb-1">
                    <span class="text-gray-700 font-medium">{{ theme|replace({'-': ' '})|title }}</span>
                    <span class="text-gray-500">{{ stats.correct }}/{{ stats.total }} ({{ pct }}%)</span>
                </div>
                <div class="w-full bg-gray-100 rounded-full h-2">
                    <div class="h-2 rounded-full transition-all
                        {% if pct >= 75 %}bg-green-400
                        {% elseif pct >= 50 %}bg-yellow-400
                        {% else %}bg-red-400
                        {% endif %}"
                         style="width: {{ pct }}%"></div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>

{# Actions #}
<div class="flex flex-wrap gap-3 justify-center">
    {% if wrong_questions|length > 0 %}
        <a href="{{ path('review_list') }}"
           class="bg-gray-800 hover:bg-gray-700 text-white font-semibold px-8 py-3 rounded-xl transition-colors">
            Revoir les {{ wrong_questions|length }} erreur{{ wrong_questions|length > 1 ? 's' : '' }}
        </a>
    {% endif %}
    <form method="POST" action="{{ path('quiz_start') }}">
        <button type="submit"
                class="bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 font-semibold px-8 py-3 rounded-xl transition-colors">
            Nouveau quiz
        </button>
    </form>
    <a href="{{ path('home') }}"
       class="bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 font-semibold px-8 py-3 rounded-xl transition-colors">
        Accueil
    </a>
</div>
{% endblock %}
