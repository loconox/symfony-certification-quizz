{% extends 'base.html.twig' %}

{% block title %}Accueil — Symfony Certification Quiz{% endblock %}

{% block body %}
<div class="text-center mb-10">
    <h1 class="text-4xl font-bold text-gray-800 mb-3">Prépare ta certification Symfony 8</h1>
    <p class="text-gray-500 text-lg">Questions aléatoires, 3 types de réponses, correction détaillée.</p>
</div>

<div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8 mb-8">
    <div class="flex flex-col items-center gap-6">
        <div class="text-6xl">🧪</div>
        <div class="text-center">
            <p class="text-gray-600 mb-1">Base de données</p>
            <p class="text-3xl font-bold text-gray-800">{{ total_questions }} questions</p>
            <p class="text-gray-400 text-sm">réparties sur {{ count_by_theme|length }} thèmes</p>
        </div>

        {% if active_session and not active_session.completed %}
            <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-4 text-center w-full max-w-sm">
                <p class="text-yellow-800 font-medium mb-1">Session en cours</p>
                <p class="text-yellow-600 text-sm">Question {{ active_session.currentIndex() + 1 }} / {{ active_session.totalQuestions() }}</p>
                <a href="{{ path('quiz_question', {index: active_session.currentIndex() + 1}) }}"
                   class="mt-3 inline-block bg-yellow-400 hover:bg-yellow-500 text-gray-900 font-semibold px-6 py-2 rounded-lg transition-colors">
                    Reprendre
                </a>
            </div>
        {% endif %}

        <div class="flex gap-3 flex-wrap justify-center">
            <form method="POST" action="{{ path('quiz_start') }}" class="flex items-center gap-3 flex-wrap justify-center">
                <div class="flex items-center gap-2 bg-gray-50 border border-gray-200 rounded-xl px-4 py-3">
                    <label for="count" class="text-gray-600 text-sm font-medium whitespace-nowrap">Nombre de questions</label>
                    <input type="number"
                           id="count"
                           name="count"
                           value="{{ total_questions }}"
                           min="1"
                           max="{{ total_questions }}"
                           class="w-20 text-center font-semibold text-gray-800 bg-white border border-gray-300 rounded-lg px-2 py-1 focus:outline-none focus:ring-2 focus:ring-gray-400">
                </div>
                <button type="submit"
                        class="bg-gray-800 hover:bg-gray-700 text-white font-semibold px-8 py-3 rounded-xl text-lg transition-colors">
                    {% if active_session %}Nouvelle session{% else %}Démarrer le quiz{% endif %}
                </button>
            </form>
            {% if active_session and active_session.completed %}
                <a href="{{ path('quiz_results') }}"
                   class="bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 font-semibold px-8 py-3 rounded-xl text-lg transition-colors">
                    Voir les résultats
                </a>
            {% endif %}
        </div>
    </div>
</div>

<div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6">
    <h2 class="text-lg font-semibold text-gray-700 mb-4">Thèmes couverts</h2>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
        {% for theme, count in count_by_theme %}
            <div class="flex items-center justify-between bg-gray-50 rounded-lg px-4 py-3">
                <span class="text-gray-700 text-sm font-medium">{{ theme|replace({'-': ' '})|title }}</span>
                <span class="text-gray-400 text-xs bg-white border border-gray-200 rounded-full px-2 py-0.5">{{ count }}</span>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
