<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Symfony Certification Quiz{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🎓</text></svg>">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">
    <header class="bg-white border-b border-gray-200 shadow-sm">
        <div class="max-w-4xl mx-auto px-4 py-4 flex items-center justify-between">
            <a href="{{ path('home') }}" class="flex items-center gap-3 font-bold text-gray-800 text-lg hover:text-yellow-500 transition-colors">
                <span class="text-2xl">🎓</span>
                <span>Symfony Certification Quiz</span>
            </a>
            <span class="text-xs text-gray-400 bg-gray-100 px-2 py-1 rounded">Symfony 8</span>
        </div>
    </header>

    <main class="max-w-4xl mx-auto px-4 py-8">
        {% block body %}{% endblock %}
    </main>
</body>
</html>
