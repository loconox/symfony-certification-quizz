{% extends 'base.html.twig' %}

{% block title %}Révision des erreurs — Symfony Certification Quiz{% endblock %}

{% block body %}
<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-800">
        Révision — {{ wrong_questions|length }} erreur{{ wrong_questions|length > 1 ? 's' : '' }}
    </h1>
    <a href="{{ path('quiz_results') }}" class="text-gray-500 hover:text-gray-700 text-sm transition-colors">
        ← Résultats
    </a>
</div>

{% if wrong_questions|length == 0 %}
    <div class="bg-green-50 border border-green-200 rounded-2xl p-8 text-center">
        <p class="text-green-700 text-lg font-medium">🎉 Aucune erreur !</p>
    </div>
{% else %}
    <div class="space-y-3">
        {% for item in wrong_questions %}
            {% set question = item.question %}
            <a href="{{ path('review_detail', {questionId: question.id}) }}"
               class="block bg-white rounded-xl border border-gray-200 hover:border-gray-400 p-4 transition-all group">
                <div class="flex items-start gap-3">
                    <span class="text-red-400 mt-0.5 shrink-0">✗</span>
                    <div class="flex-1 min-w-0">
                        <p class="text-gray-800 font-medium leading-snug group-hover:text-gray-900">
                            {{ question.question|slice(0, 120) }}{{ question.question|length > 120 ? '…' : '' }}
                        </p>
                        <p class="text-gray-400 text-xs mt-1">{{ question.theme|replace({'-': ' '})|title }}</p>
                    </div>
                    <span class="text-gray-300 group-hover:text-gray-500 shrink-0">→</span>
                </div>
            </a>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
