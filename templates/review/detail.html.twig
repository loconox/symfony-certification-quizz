{% extends 'base.html.twig' %}

{% block title %}Révision — Symfony Certification Quiz{% endblock %}

{% block body %}
{# Navigation #}
<div class="flex items-center justify-between mb-6">
    <a href="{{ path('review_list') }}" class="text-gray-500 hover:text-gray-700 text-sm transition-colors">
        ← Liste des erreurs
    </a>
    <span class="text-gray-400 text-sm">{{ current_pos }} / {{ total_wrong }}</span>
</div>

<div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8 mb-4">
    {# Theme + type #}
    <div class="flex gap-2 mb-4">
        <span class="bg-gray-100 text-gray-600 text-xs font-medium px-3 py-1 rounded-full">
            {{ question.theme|replace({'-': ' '})|title }}
        </span>
        {% if question.type == 'boolean' %}
            <span class="bg-blue-100 text-blue-700 text-xs font-medium px-3 py-1 rounded-full">Vrai / Faux</span>
        {% elseif question.type == 'single' %}
            <span class="bg-purple-100 text-purple-700 text-xs font-medium px-3 py-1 rounded-full">Réponse unique</span>
        {% else %}
            <span class="bg-orange-100 text-orange-700 text-xs font-medium px-3 py-1 rounded-full">Choix multiple</span>
        {% endif %}
    </div>

    {# Question #}
    <h2 class="text-xl font-semibold text-gray-800 mb-6 leading-relaxed">{{ question.question }}</h2>

    {# Answers #}
    <div class="space-y-3 mb-8">
        {% for answer in question.answers %}
            <div class="flex items-start gap-3 p-4 rounded-xl border-2
                {% if answer.correct and answer.id in user_answers %}border-green-400 bg-green-50
                {% elseif answer.correct %}border-green-300 bg-green-50
                {% elseif answer.id in user_answers %}border-red-300 bg-red-50
                {% else %}border-gray-100 bg-gray-50
                {% endif %}">
                <span class="mt-0.5 shrink-0 font-bold
                    {% if answer.correct %}text-green-600
                    {% elseif answer.id in user_answers %}text-red-500
                    {% else %}text-gray-300
                    {% endif %}">
                    {% if answer.correct %}✓{% elseif answer.id in user_answers %}✗{% else %}○{% endif %}
                </span>
                <span class="text-gray-700 leading-snug">{{ answer.text }}</span>
                {% if answer.correct %}
                    <span class="ml-auto text-green-600 text-xs font-medium shrink-0">bonne réponse</span>
                {% elseif answer.id in user_answers %}
                    <span class="ml-auto text-red-500 text-xs font-medium shrink-0">ta réponse</span>
                {% endif %}
            </div>
        {% endfor %}
    </div>

    {# Explanation #}
    <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-5">
        <p class="text-sm font-semibold text-yellow-800 mb-2">💡 Explication</p>
        <p class="text-gray-700 leading-relaxed">{{ question.explanation }}</p>
        {% if question.docUrl %}
            <a href="{{ question.docUrl }}" target="_blank" rel="noopener noreferrer"
               class="mt-3 inline-flex items-center gap-1 text-sm text-blue-600 hover:text-blue-800 transition-colors">
                📖 Documentation Symfony
                <span class="text-xs">↗</span>
            </a>
        {% endif %}
    </div>
</div>

{# Navigation between wrong answers #}
<div class="flex justify-between">
    {% if prev_id %}
        <a href="{{ path('review_detail', {questionId: prev_id}) }}"
           class="bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 font-medium px-6 py-2 rounded-xl transition-colors text-sm">
            ← Précédente
        </a>
    {% else %}
        <span></span>
    {% endif %}

    {% if next_id %}
        <a href="{{ path('review_detail', {questionId: next_id}) }}"
           class="bg-gray-800 hover:bg-gray-700 text-white font-medium px-6 py-2 rounded-xl transition-colors text-sm">
            Suivante →
        </a>
    {% else %}
        <a href="{{ path('quiz_results') }}"
           class="bg-gray-800 hover:bg-gray-700 text-white font-medium px-6 py-2 rounded-xl transition-colors text-sm">
            Retour aux résultats
        </a>
    {% endif %}
</div>
{% endblock %}
